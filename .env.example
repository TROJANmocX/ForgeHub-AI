# ─────────────────────────────────────────
# ForgeHub AI — Environment Configuration
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# Demo mode: no DataHub server, no API keys required
DEMO_MODE=true

# DataHub connection (required when DEMO_MODE=false)
DATAHUB_URL=http://localhost:8080
DATAHUB_TOKEN=

# LLM provider: mock | anthropic | openai | gemini
LLM_PROVIDER=mock

# LLM API keys (only needed for non-mock providers)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Self-repair loop cap
MAX_REPAIR_ATTEMPTS=3

# CORS origin for frontend (default Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173
